rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isOwnerApplicationCreate() {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.hackathon is string
        && request.resource.data.project is string
        && request.resource.data.idea is string
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp);
    }

    function isOwnerApplicationUpdate() {
      return signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /hackathons/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /participants/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid;
    }

    match /applications/{docId} {
      allow create: if isOwnerApplicationCreate();
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if isOwnerApplicationUpdate();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}